# Copy to .env.integrations (gitignored). Push to VPS:
#   $env:VPS_ROOT_PASSWORD = '...'
#   .\scripts\push-olive-integrations.ps1
#
# LOGICTECK team gives you BookUrl (and optionally Portal / EmptyReturn).
# Use the SAME ApiKey as LOGICTECK_API_KEY on the server (already on VPS if deploy ran).

# --- LOGICTECK → ICS (public API base; no trailing slash, no /api) ---
Logicteck__PublicApiBaseUrl=http://201.18.216.37
Logicteck__ApiKey=shared-secret-with-logicteck
Logicteck__AutoTransferOnQrPublish=false

# --- ICS → LOGICTECK (outbound POST) ---
Logicteck__BookUrl=https://YOUR-LOGICTECK-HOST/api/receive-preadvice
Logicteck__PortalUrl=https://YOUR-LOGICTECK-HOST/portal
Logicteck__EmptyReturnUrl=https://YOUR-LOGICTECK-HOST/api/empty-return

# --- Firebase FCM (same Firebase project as android-trucker/app/google-services.json) ---
# Use the service account JSON from Firebase Console (often saved next to google-services.json):
FIREBASE_SERVICE_ACCOUNT_FILE=C:\xampp\htdocs\ecms\android-trucker\app\ecms-6d551-firebase-adminsdk-fbsvc-05a11bc692.json
# Option B: single-line JSON in env (hard on Windows; use file instead)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# --- LOGICTECK → ICS allocation feed (local preview; header X-ICS-Api-Key) ---
Logicteck__AllocationsUrl=https://logicteck-cy--logicteck-cy-playground.asia-southeast1.hosted.app/api/ics/allocations
ICS_INBOUND_API_KEY=replace-with-logicteck-inbound-key

# --- Redis (optional; install on VPS first: scripts/vps/install-redis-local.sh) ---
# Not used for push — FCM is separate. Reserved for future cache / rate-limit sharing.
ConnectionStrings__Redis=127.0.0.1:6379
