# Olive ICS — API on VPS with local MariaDB (not Hostinger Remote MySQL).
# Copy to .env.olive (gitignored). MYSQL_* on the server are set by install-mysql-local.sh.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecms
MYSQL_USER=ecms
# Leave empty locally; VPS stores the real password in /etc/ecms/ecms-api.env
MYSQL_PASSWORD=

JWT_KEY=at-least-32-characters-same-as-railway-if-migrating-tokens
Logicteck__ApiKey=copy-from-.env.production
