# LiteSpeed/Hostinger: static JS/CSS must not be gzip-transformed or length-mismatched over HTTP/2.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "." no-gzip
  SetEnvIf Request_URI "." dont-vary
</IfModule>

<IfModule mod_headers.c>
  Header always unset Content-Length
  Header always set Cache-Control "public, max-age=31536000, immutable, no-transform"
  Header always set X-Content-Type-Options nosniff
</IfModule>

<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule .* - [E=cache-control:no-cache]
</IfModule>
