# Copy to deploy-config.ps1 and fill in secrets (deploy-config.ps1 is gitignored).
@{
    SshHost     = '82.25.100.95'
    SshPort     = 65002
    # Olive ICS site (2026). Legacy site used u910121167_HVdBWy0pE + hostinger_ecms key.
    SshUser     = 'u910121167_HvBkp6EsX'
    SshKey      = Join-Path $env:USERPROFILE '.ssh\hostinger_ecms_ics2026'
    # Optional: pin Hostinger host key for plink/pscp batch mode
    # SshHostKey  = 'SHA256:xxxxxxxx'
    SshPassword = ''  # Hostinger SSH Access password
    RemotePath  = '/home/u910121167/websites/HvBkp6EsX/public_html'
    AppUrl      = 'https://olive-mole-175469.hostingersite.com'
    # Direct API URL (CORS). Leave empty when using Hostinger proxy to VPS.
    ApiBaseUrl  = 'https://ecms-production-42be.up.railway.app/api'
    # Olive on VPS: set UseHostingerApiProxy = $true and run scripts/deploy-olive-vps.ps1
    UseHostingerApiProxy = $true
    VpsHost     = '201.18.216.37'
    VpsUser     = 'root'
    # SSH key for VPS (optional; defaults to SshKey if empty)
    VpsSshKey   = ''
    VpsUpstream = 'http://201.18.216.37'
    GitBranch   = 'main'
    HostingerGitBranch = 'hostinger'     # orphan branch with frontend/dist contents
    GitHubRepo  = 'jdflores22/ecms'
    # Required for private repos (Hostinger git fetch). Prefer a fine-scoped PAT (contents:read).
    # Or set env ECMS_GITHUB_TOKEN / GITHUB_TOKEN instead of storing here.
    GitHubToken = ''
}
